import random
import pandas as pd

# --- Step 1: Define 50 names ---
names = [
    "Alice", "Bob", "Charlie", "David", "Eva", "Frank", "Grace", "Hannah", "Ian", "Julia",
    "Kevin", "Laura", "Michael", "Nina", "Oscar", "Paula", "Quentin", "Rachel", "Steve", "Tina",
    "Uma", "Victor", "Wendy", "Xander", "Yara", "Zane", "Liam", "Sophia", "Noah", "Olivia",
    "Mason", "Emma", "Ethan", "Ava", "Logan", "Isabella", "Lucas", "Mia", "Jackson", "Amelia",
    "Aiden", "Harper", "Caden", "Evelyn", "Elijah", "Abigail", "Jacob", "Emily", "Sebastian", "Charlotte"
]

# --- Step 2: Define possible cities ---
cities = ["New York", "London", "Paris", "Tokyo", "Berlin", "Sydney", "Toronto", "Mumbai", "Rome", "Dubai"]

# --- Step 3: Assign random age and city to each name ---
ages = [random.randint(20, 60) for _ in names]
assigned_cities = [random.choice(cities) for _ in names]

# --- Step 4: Create DataFrame ---
data = {
    "name": names,
    "age": ages,
    "city": assigned_cities
}
df = pd.DataFrame(data)

# --- Step 5: Display the DataFrame ---
print(df)

# --- Step 6: Optional: Save to CSV ---
df.to_csv("names_with_age_city.csv", index=False)
print("\nDataset saved to 'names_with_age_city.csv'")
